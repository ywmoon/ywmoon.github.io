#!/bin/bash
# ==============================================================================
# 🚀 DC InfraOps Blog - One-Click Deploy Launcher (macOS Double-Clickable)
# ==============================================================================

# 이동: 스크립트가 위치한 디렉토리 기준
DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
cd "$DIR"

echo "=================================================================="
echo "🐙 [DC InfraOps Blog] 깃허브 블로그 원클릭 자동 배포 가동..."
echo "=================================================================="
echo ""

# 파이썬 배포 스크립트 실행
python3 "$DIR/deploy.py"

echo ""
echo "=================================================================="
echo "✨ 모든 작업이 완료되었습니다. 창을 닫으셔도 됩니다."
echo "=================================================================="
read -n 1 -s -r -p "엔터(Enter) 키를 누르면 종료됩니다..."
echo ""
